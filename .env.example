# Contact form email delivery (used by /api/contact.js via Resend).
# Set these in Vercel → Project → Settings → Environment Variables (NOT in the repo).

# Required — your Resend API key (https://resend.com → API Keys). Starts with "re_".
RESEND_API_KEY=re_your_key_here

# Optional — where contact-form inquiries are delivered. Defaults to suchiban07@gmail.com.
CONTACT_TO=suchiban07@gmail.com

# Optional — the "From" address. Must be a Resend-verified sender.
# Default is Resend's onboarding sender, which ONLY delivers to the Resend
# account owner's email. For real delivery to any inbox, verify your domain
# in Resend and use something like: "Suchi Bansal Portfolio <noreply@suchibansal.com>"
CONTACT_FROM=Suchi Bansal Portfolio <onboarding@resend.dev>
