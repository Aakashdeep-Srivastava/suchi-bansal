{
  "name": "portfolio-website",
  "version": "1.0.0",
  "private": true,
  "description": "Monochrome Editorial Developer & Designer Portfolio",
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 8080",
    "start": "python3 -m http.server 8080",
